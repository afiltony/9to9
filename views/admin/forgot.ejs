<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Forgot password · 9 TO 9 Meet</title>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= typeof v !== 'undefined' ? v : '' %>">
</head>
<body>
<main class="login-shell">
  <div class="login-card">
    <div class="brand"><span class="brand-mark">9·9</span><span class="brand-text"><strong>9 TO 9 MEET</strong><span>Staff &amp; volunteers</span></span></div>
    <h1 class="center" style="font-size:1.4rem">Forgot your password?</h1>
    <p class="muted">For security, staff passwords are reset by an event administrator — no reset emails are sent.</p>
    <p class="muted">Ask an administrator to open <strong>Users &amp; roles</strong>, choose your account and set a new password. You'll be signed out of other devices when it changes.</p>
    <a class="btn block" href="/admin/login">Back to sign in</a>
  </div>
</main>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · 9 TO 9 Meet</title>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= typeof v !== 'undefined' ? v : '' %>">
  <% if (content && content.theme) { %><style>:root { --primary: <%= content.theme.primary %>; --secondary: <%= content.theme.secondary %>; }</style><% } %>
</head>
<body>
<main class="login-shell">
  <div class="login-card">
    <div class="brand">
      <span class="brand-mark"><% if (event && event.logo_path) { %><img src="/media/<%= event.logo_path %>" alt=""><% } else { %>9·9<% } %></span>
      <span class="brand-text"><strong>9 TO 9 MEET</strong><span>Staff &amp; volunteers</span></span>
    </div>
    <h1 class="center" style="font-size:1.4rem">Sign in</h1>
    <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
    <% if (flash) { %><div class="alert <%= flash.type %>" role="status"><%= flash.text %></div><% } %>
    <form method="post" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <div class="spread" style="margin-bottom:18px">
        <label class="check small"><input type="checkbox" name="remember"> Keep me signed in on this device</label>
        <a class="small" href="/admin/forgot-password">Forgot password?</a>
      </div>
      <button class="btn block lg" type="submit" data-loading-text="Signing in…">Sign in</button>
    </form>
    <p class="center small" style="margin:18px 0 0"><a href="/">← Back to the event site</a></p>
  </div>
</main>
<script src="/static/js/common.js?v=<%= typeof v !== 'undefined' ? v : '' %>"></script>
</body>
</html>

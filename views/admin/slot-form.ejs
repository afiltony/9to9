<% const sid = slot ? slot.id.slice(0, 8) : 'new'; %>
<form method="post" action="/admin/slots">
  <input type="hidden" name="_csrf" value="<%= csrf() %>">
  <input type="hidden" name="back" value="<%= back %>">
  <% if (slot) { %><input type="hidden" name="slot_id" value="<%= slot.id %>"><% } %>
  <% if (activityId) { %><input type="hidden" name="activity_id" value="<%= activityId %>">
  <% } else { %>
    <div class="field"><label for="s-act-<%= sid %>">Activity</label>
      <select id="s-act-<%= sid %>" name="activity_id" required><option value="">Choose…</option><% for (const a of activities) { if (!a.requires_slot) continue; %><option value="<%= a.id %>"><%= a.name %></option><% } %></select></div>
  <% } %>
  <div class="form-row three">
    <div class="field"><label for="s-date-<%= sid %>">Date</label><input id="s-date-<%= sid %>" type="date" name="date" value="<%= slot ? slot.start_at.slice(0, 10) : (defaultDate || '') %>" required></div>
    <div class="field"><label for="s-start-<%= sid %>">Start</label><input id="s-start-<%= sid %>" type="time" name="start_time" value="<%= slot ? slot.start_at.slice(11, 16) : '' %>" required></div>
    <div class="field"><label for="s-end-<%= sid %>">End</label><input id="s-end-<%= sid %>" type="time" name="end_time" value="<%= slot ? slot.end_at.slice(11, 16) : '' %>" required>
      <div class="help">Earlier than the start = next day.</div></div>
  </div>
  <div class="form-row three">
    <div class="field"><label for="s-cap-<%= sid %>">Capacity</label><input id="s-cap-<%= sid %>" type="number" min="0" name="capacity" value="<%= slot ? (slot.capacity ?? '') : (defaultCapacity ?? '') %>" placeholder="No limit"></div>
    <div class="field"><label for="s-status-<%= sid %>">Status</label>
      <select id="s-status-<%= sid %>" name="status"><option value="open" <%= slot && slot.status === 'closed' ? '' : 'selected' %>>Open</option><option value="closed" <%= slot && slot.status === 'closed' ? 'selected' : '' %>>Closed</option></select>
      <div class="help">“Full” is automatic when capacity is reached.</div></div>
    <div class="field"><label for="s-label-<%= sid %>">Detail (speaker, programme)</label><input id="s-label-<%= sid %>" name="label" value="<%= slot ? (slot.label || '') : '' %>" maxlength="255"></div>
  </div>
  <button class="btn sm" type="submit"><%= slot ? 'Save slot' : 'Add slot' %></button>
</form>

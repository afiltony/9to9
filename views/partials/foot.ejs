</main>
<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <a href="/" aria-label="9 TO 9 Meet home"><img class="footer-logo" src="<%= event && event.logo_path ? '/media/' + event.logo_path : '/static/img/logo-wordmark.jpg' %>" alt="9 TO 9 Meet" width="480" height="149" loading="lazy"></a>
      <div>
        <strong>24 Hour God Experience</strong>
        <span><%= content && content.hero_kicker ? content.hero_kicker : '' %><%= event ? ' · ' + fmt.shortDate(event.start_at) + ' – ' + fmt.shortDate(event.end_at) + (event.venue ? ' · ' + event.venue : '') : '' %></span>
      </div>
    </div>
    <div class="footer-grid">
      <div>
        <h4>The event</h4>
        <% if (event) { %>
          <p style="margin:0"><%= fmt.dayLabel(event.start_at) %>, <%= fmt.time(event.start_at) %><br>to <%= fmt.dayLabel(event.end_at) %>, <%= fmt.time(event.end_at) %></p>
          <% if (event.venue) { %><p style="margin:8px 0 0"><%= event.venue %></p><% } %>
        <% } %>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <% if (event && event.contact_phone) { %><li><strong>t:</strong> <a href="tel:<%= event.contact_phone.replace(/\s/g, '') %>"><%= event.contact_phone %></a></li><% } %>
          <% if (event && event.contact_email) { %><li><strong>e:</strong> <a href="mailto:<%= event.contact_email %>"><%= event.contact_email %></a></li><% } %>
          <li><a href="/contact">Help &amp; contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="/schedule">Schedule</a></li>
          <li><a href="/activities">Activities</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
      <div>
        <h4>Join us</h4>
        <p>Register online, book your activity slots and collect your card at reception.</p>
        <a class="btn gold sm" href="/register">Register</a>
      </div>
    </div>
    <% if (content && content.organizers) { %><p class="small" style="margin:28px 0 0;color:rgb(255 255 255 / 75%)"><%= content.organizers %></p><% } %>
    <div class="footer-bottom">
      <span>Copyright © <%= event ? event.start_at.slice(0, 4) : '' %> 9 TO 9 Meet | <a href="/privacy">Privacy Policy</a> | <a href="/terms">Terms</a></span>
      <a href="/admin/login">Staff login</a>
    </div>
  </div>
</footer>
<% if (state && state.open && path !== '/register' && !path.startsWith('/r/')) { %>
<div class="mobile-cta">
  <span class="txt"><strong>9 TO 9 Meet</strong><%= event ? fmt.shortDate(event.start_at) + ' – ' + fmt.shortDate(event.end_at) : '' %> · places are limited</span>
  <a class="btn gold" href="/register">Register</a>
</div>
<% } %>
<% if (!path.startsWith('/r/')) { %>
<dialog class="poster-popup" data-poster-popup aria-label="9 TO 9 Meet event poster">
  <button class="poster-popup-close" type="button" data-poster-close aria-label="Close">&times;</button>
  <img data-src="/static/img/poster-popup.jpg?v=<%= typeof v !== 'undefined' ? v : '' %>" alt="9 TO 9 Meet — Eyes opened, hearts on fire. 24 hour God experience, 10–11 October at Media Village." width="900" height="1183">
  <div class="poster-popup-actions">
    <% if (state && state.open && path !== '/register') { %><a class="btn gold" href="/register">Register now</a><% } %>
    <button class="btn light" type="button" data-poster-close>Enter website</button>
  </div>
</dialog>
<% } %>
<script src="/static/js/common.js?v=<%= typeof v !== 'undefined' ? v : '' %>"></script>
</body>
</html>

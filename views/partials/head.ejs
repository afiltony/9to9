<%
  const c = content || {};
  const theme = c.theme || {};
  const siteTitle = '9 TO 9 Meet – 24 Hour God Experience';
  const pageTitle = typeof title !== 'undefined' && title ? `${title} · 9 TO 9 Meet` : siteTitle;
  const desc = typeof description !== 'undefined' && description ? description
    : `${event ? event.subtitle + '. ' : ''}10 October 9 AM to 11 October 9 AM${event && event.venue ? ' at ' + event.venue : ''}. Register online and book your activity slots.`;
  // link previews (WhatsApp, Facebook…) use the wording and image of the current poster
  const shareTitle = typeof title !== 'undefined' && title ? pageTitle : '9 TO 9 Meet – St. Carlo Fest 2026 · യുവനസ്രാണി സംഗമം';
  const shareDesc = typeof description !== 'undefined' && description ? description
    : `From Emmaus Blindness to Eucharistic Vision (Lk 24:13-35). Come, walk with Him. Oct 10, 9 AM to Oct 11, 9 AM${event && event.venue ? ' at ' + event.venue : ''}. Register online at www.mvevents.in`;
  const shareImg = '/static/img/poster-popup.jpg?v=' + v;
  const showMobileCta = !!(state && state.open && path !== '/register' && !path.startsWith('/r/'));
  const navLink = (href, label) => `<a href="${href}"${path === href ? ' aria-current="page"' : ''}>${label}</a>`;
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= desc %>">
  <link rel="canonical" href="<%= baseUrl + path %>">
  <meta name="theme-color" content="<%= theme.primary || '#ce2029' %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="9 TO 9 Meet">
  <meta property="og:title" content="<%= shareTitle %>">
  <meta property="og:description" content="<%= shareDesc %>">
  <meta property="og:url" content="<%= baseUrl + path %>">
  <meta property="og:image" content="<%= baseUrl + shareImg %>">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="900">
  <meta property="og:image:height" content="1181">
  <meta property="og:image:alt" content="9 TO 9 Meet poster — St. Carlo Fest 2026, യുവനസ്രാണി സംഗമം. From Emmaus Blindness to Eucharistic Vision. Oct 10 9 AM to Oct 11 9 AM at Media Village.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= shareTitle %>">
  <meta name="twitter:description" content="<%= shareDesc %>">
  <meta name="twitter:image" content="<%= baseUrl + shareImg %>">
  <link rel="preload" href="/static/fonts/roboto-slab/files/roboto-slab-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/roboto/files/roboto-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= typeof v !== 'undefined' ? v : '' %>">
  <% if (theme.primary) { %><style>:root { --primary: <%= theme.primary %>; --secondary: <%= theme.secondary %>; }</style><% } %>
  <script src="/static/js/boot.js?v=<%= typeof v !== 'undefined' ? v : '' %>"></script>
</head>
<body<%- showMobileCta ? ' class="has-mobile-cta"' : '' %>>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="9 TO 9 Meet home">
      <img class="brand-logo" src="<%= event && event.logo_path ? '/media/' + event.logo_path : '/static/img/logo-wordmark.jpg' %>" alt="9 TO 9 Meet" width="480" height="149" fetchpriority="high">
      <span class="brand-tagline">24 Hour <br>God Experience</span>
    </a>
    <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-menu-toggle>
      <%- include('icon', { name: 'menu' }) %><span class="sr-only">Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <%- navLink('/schedule', 'Schedule') %>
      <%- navLink('/activities', 'Activities') %>
      <%- navLink('/about', 'About') %>
      <%- navLink('/contact', 'Contact') %>
      <% if (state && state.open) { %><a class="btn gold" href="/register">Register now</a><% } %>
    </nav>
  </div>
</header>
<div class="sponsor-bar" lang="ml">
  <div class="container">
    <strong>പ്രസുദേന്തി:</strong>
    <span>ജിമ്മി പടനിലം</span>
    <span>ഡോ. ജോർജ് &amp; മറിയം പടനിലം ചാരിറ്റബിൾ ഫൗണ്ടേഷൻ</span>
  </div>
</div>
<main id="main">

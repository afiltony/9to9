# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
# Public address of the site; printed inside every QR code, so set it before cards are issued
BASE_URL=http://localhost:3000

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MySQL / MariaDB (XAMPP locally; Hostinger hPanel > Databases in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nine_to_nine
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10

# Event
EVENT_CODE=9TO9
EVENT_YEAR=2026
# Event-local UTC offset (India = +05:30)
TZ_OFFSET=+05:30

# First deploy without SSH (Hostinger): create tables, load the programme and the first admin on start.
# All three are safe to leave on; remove INITIAL_ADMIN_PASSWORD after the first successful start.
AUTO_MIGRATE=false
AUTO_SEED=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Where photos are stored (kept outside the public folder)
STORAGE_DIR=storage
MAX_PHOTO_KB=1024

# Number of reverse proxies in front of the app (Hostinger: 1). Defaults to 1 in production.
# TRUST_PROXY=1
